@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdd = Context.Request.Query.ContainsKey("add");
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
    var isAdmin = User.IsInRole("Admin");
    string Active(string a, bool cond = true) => (action == a && cond) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Dengue Alert LK</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <style>
            :root { --brand:#0b8a72; --brand-dark:#087360; --side:#0a3b4a; --side2:#0f4c5e;
                    --bg:#f3f6f8; --text:#0f172a; --muted:#64748b; --border:#e2e8f0; }
            body { font-family:'Inter',system-ui,sans-serif; background:var(--bg); color:var(--text); margin:0; }

            .sidebar { width:260px; background:var(--side); color:#cfe3e8; position:fixed; top:0; bottom:0; left:0;
                       display:flex; flex-direction:column; z-index:1040; transition:transform .25s; overflow-y:auto; }
            .brand { display:flex; align-items:center; gap:12px; padding:18px 20px; color:#fff; text-decoration:none; }
            .brand .logo { width:48px; height:48px; border-radius:50%; border:2px solid #fff; display:grid; place-items:center; font-size:1.5rem; flex-shrink:0; }
            .brand b { display:block; font-size:1.05rem; line-height:1.15; }
            .brand small { color:#a5c4cc; font-size:.7rem; }
            .side-link { display:flex; align-items:center; gap:14px; margin:2px 12px; padding:11px 14px; border-radius:10px;
                         color:#cfe3e8; text-decoration:none; font-weight:500; font-size:.92rem; }
            .side-link:hover { background:var(--side2); color:#fff; }
            .side-link.active { background:var(--brand); color:#fff; }
            .side-link i { font-size:1.1rem; }
            .prevent { margin:18px 14px 16px; padding:16px; border-radius:12px; background:var(--brand); color:#fff; border:1px solid rgba(255,255,255,.25); }
            .prevent h6 { text-align:center; font-weight:700; margin-bottom:10px; }
            .prevent li { list-style:none; font-size:.82rem; margin-bottom:6px; display:flex; gap:8px; }
            .prevent ul { padding:0; margin:0; }

            .main { margin-left:260px; min-width:0; min-height:100vh; transition:margin .25s; }
            body.side-hidden .sidebar { transform:translateX(-100%); }
            body.side-hidden .main { margin-left:0; }
            .topbar { height:64px; background:var(--brand); color:#fff; display:flex; align-items:center; padding:0 22px; gap:10px; position:sticky; top:0; z-index:1030; }
            .topbar .icon-btn { background:transparent; border:0; color:#fff; font-size:1.4rem; position:relative; }
            .topbar .dot { position:absolute; top:2px; right:0; width:9px; height:9px; background:#ef4444; border-radius:50%; }
            .user-chip { display:flex; align-items:center; gap:10px; color:#fff; text-decoration:none; font-weight:500; }
            .avatar { width:36px; height:36px; border-radius:50%; background:#d1e7e2; color:var(--brand); font-weight:700; display:grid; place-items:center; }
            .content { padding:24px 28px; }

            .page-head { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; margin-bottom:20px; }
            .page-head h1 { font-size:1.55rem; font-weight:700; margin:0; }
            .page-head p { margin:2px 0 0; color:var(--muted); font-size:.9rem; }
            .range-box { display:flex; align-items:center; gap:8px; background:#fff; border:1px solid var(--border); border-radius:10px; padding:6px 10px; }
            .range-box input { width:150px; }

            .stat { background:#fff; border:1px solid var(--border); border-radius:14px; padding:18px 20px; display:flex; align-items:center; gap:16px; height:100%; }
            .stat .icon { width:60px; height:60px; border-radius:50%; display:grid; place-items:center; font-size:1.6rem; color:#fff; flex-shrink:0; }
            .stat .label { color:var(--muted); font-size:.82rem; }
            .stat .value { font-size:1.8rem; font-weight:700; line-height:1.15; }
            .stat .chg { font-size:.78rem; font-weight:500; }
            .bg-purple { background:#7c3aed; } .bg-red { background:#ef4444; } .bg-orange { background:#f97316; } .bg-green { background:var(--brand); }
            .up-bad, .down-good { color:#16a34a; } .up-bad { color:#dc2626; }
            .up-good { color:#16a34a; } .down-bad { color:#dc2626; }

            .panel { background:#fff; border:1px solid var(--border); border-radius:14px; overflow:hidden; height:100%; }
            .panel-head { padding:14px 20px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; border-bottom:1px solid var(--border); }
            .panel-head b { font-size:.98rem; }
            .panel-body { padding:16px 20px; }
            .search { position:relative; width:280px; max-width:100%; }
            .search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; }
            .search input { padding-left:36px; }

            .table-modern { margin:0; }
            .table-modern thead th { background:#f8fafc; color:var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; font-weight:600; padding:12px 18px; white-space:nowrap; border-bottom:1px solid var(--border); }
            .table-modern td { padding:12px 18px; vertical-align:middle; border-color:#f1f5f9; }
            .table-modern tbody tr:hover { background:#f8fafc; }

            .risk { display:inline-block; padding:.3em .8em; border-radius:6px; font-weight:600; font-size:.74rem; color:#fff; }
            .risk-high { background:#ef4444; } .risk-medium { background:#f97316; } .risk-low { background:#16a34a; }

            .btn-primary { background:var(--brand); border-color:var(--brand); border-radius:10px; font-weight:500; }
            .btn-primary:hover, .btn-primary:disabled { background:var(--brand-dark); border-color:var(--brand-dark); }
            .btn-light, .btn-outline-secondary { border-radius:10px; }
            .btn-icon { width:34px; height:34px; padding:0; display:inline-grid; place-items:center; border-radius:8px; }
            .form-control, .form-select { border-radius:10px; border-color:#cbd5e1; }
            .form-control:focus, .form-select:focus { border-color:var(--brand); box-shadow:0 0 0 .2rem rgba(11,138,114,.15); }
            .form-label { font-weight:500; font-size:.85rem; }
            .modal-content { border:0; border-radius:16px; box-shadow:0 20px 60px rgba(15,23,42,.25); }
            .modal-title { font-weight:700; font-size:1.1rem; }
            .empty { padding:40px 20px; text-align:center; color:var(--muted); }
            .empty i { font-size:2.2rem; color:#cbd5e1; display:block; margin-bottom:6px; }
            .alert-banner { background:#e6f4f1; border:1px solid #cfe8e2; border-radius:14px; padding:16px 22px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
            .alert-banner i { font-size:2rem; color:var(--brand); }
            .list-scroll { max-height:520px; overflow-y:auto; }
            .filters .form-control, .filters .form-select { height:38px; }

            @@media (max-width: 991px) {
                .sidebar { transform:translateX(-100%); } .sidebar.open { transform:none; }
                .main { margin-left:0; } .content { padding:16px; }
            }
            @@media print {
                .sidebar, .topbar, .no-print { display:none !important; }
                .main { margin-left:0 !important; } body { background:#fff; }
            }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="/">
           <span class="logo"><i class="fa-solid fa-mosquito"></i></span>
            <span><b>Dengue Alert LK</b><small>Monitoring &amp; Prediction System</small></span>
        </a>
        <a class="side-link @Active("Index")" href="/"><i class="bi bi-house-door"></i> Dashboard</a>
        <a class="side-link @Active("Cases", isAdd)" href="/Home/Cases?add=1"><i class="bi bi-plus-circle"></i> Add Dengue Case</a>
        <a class="side-link @Active("Cases", !isAdd)" href="/Home/Cases"><i class="bi bi-list-ul"></i> View Cases</a>
        <a class="side-link @Active("Areas")" href="/Home/Areas"><i class="bi bi-geo-alt"></i> Areas</a>
        <a class="side-link @Active("Analytics")" href="/Home/Analytics"><i class="bi bi-bar-chart"></i> Analytics</a>
        <a class="side-link @Active("RiskMap")" href="/Home/RiskMap"><i class="bi bi-shield-exclamation"></i> Risk Map</a>
        <a class="side-link @Active("Awareness")" href="/Home/Awareness"><i class="bi bi-info-circle"></i> Awareness</a>
        @if (isAdmin)
        {
            <a class="side-link @Active("Users")" href="/Home/Users"><i class="bi bi-people"></i> Users</a>
        }
        <a class="side-link @Active("Reports")" href="/Home/Reports"><i class="bi bi-file-earmark-text"></i> Reports</a>
        <a class="side-link @Active("Settings")" href="/Home/Settings"><i class="bi bi-gear"></i> Settings</a>
        <a class="side-link" href="#" onclick="logout(); return false;"><i class="bi bi-power"></i> Logout</a>

        <div class="prevent mt-auto">
            <h6>Prevention is better<br />than Cure</h6>
            <ul>
                <li><i class="bi bi-check-circle"></i> Remove stagnant water</li>
                <li><i class="bi bi-check-circle"></i> Keep surroundings clean</li>
                <li><i class="bi bi-check-circle"></i> Use mosquito repellent</li>
                <li><i class="bi bi-check-circle"></i> Wear full sleeve clothes</li>
            </ul>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn" onclick="toggleSide()"><i class="bi bi-list"></i></button>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a href="/Home/RiskMap" class="icon-btn text-white" title="Risk map"><i class="bi bi-bell"></i><span class="dot"></span></a>
                <div class="dropdown">
                    <a class="user-chip dropdown-toggle" data-bs-toggle="dropdown" href="#">
                        <span class="avatar">@fullName[0]</span> @fullName
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Home/Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><a class="dropdown-item" href="#" onclick="logout(); return false;"><i class="bi bi-power me-2"></i>Sign out</a></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="content">@RenderBody()</main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        const $ = id => document.getElementById(id);
        const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const num = n => Number(n || 0).toLocaleString('en-US');
        const isoDate = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        const fmtDate = s => new Date(s + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
        const riskBadge = r => `<span class="risk risk-${r.toLowerCase()}">${r}</span>`;
        const riskColor = r => r === 'High' ? '#ef4444' : r === 'Medium' ? '#f97316' : '#16a34a';

        async function request(url, opts) {
        const r = await fetch(url, opts);
        if (r.status === 401) { location.href = '/Account/Login'; throw new Error('Unauthorized'); }
        return r;
        }
        const jsonOpts = (method, body) => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const errText = e => e?.message || (e?.errors ? Object.values(e.errors).flat()[0] : null) || e?.title || 'Something went wrong.';

        const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2600, timerProgressBar: true });
        const toast = (icon, title) => Toast.fire({ icon, title });
        async function confirmDelete(title, text) {
        const r = await Swal.fire({ title, text, icon: 'warning', showCancelButton: true, reverseButtons: true,
        confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel', confirmButtonColor: '#dc2626' });
        return r.isConfirmed;
        }

        function toggleSide() {
        if (window.innerWidth >= 992) document.body.classList.toggle('side-hidden');
        else $('sidebar').classList.toggle('open');
        }
        async function logout() { await fetch('/api/auth/logout', { method: 'POST' }); location.href = '/Account/Login'; }

        // Heat map + risk markers (used by Dashboard and Risk Map)
        function renderRiskLayers(map, group, data) {
        group.clearLayers();
        const max = Math.max(1, ...data.map(d => d.cases));
        const pts = data.filter(d => d.cases > 0).map(d => [d.lat, d.lng, d.cases / max]);
        if (pts.length) L.heatLayer(pts, { radius: 30, blur: 22, maxZoom: 9,
        gradient: { 0.25: '#16a34a', 0.55: '#fbbf24', 0.85: '#ef4444' } }).addTo(group);
        data.forEach(d => L.circleMarker([d.lat, d.lng], { radius: 6, color: '#fff', weight: 1.5, fillColor: riskColor(d.risk), fillOpacity: 1 })
        .bindTooltip(`<b>${esc(d.name)}</b><br>${d.cases} cases - ${d.risk} risk`).addTo(group));
        }
        function createMap(id, scroll) {
        const map = L.map(id, { scrollWheelZoom: scroll }).setView([7.8731, 80.7718], 7);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
        return map;
        }
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>