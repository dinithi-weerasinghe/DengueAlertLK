@{
    ViewData["Title"] = "Users";
}

<div class="page-head">
    <div><h1>Users</h1><p>Manage who can sign in to the system.</p></div>
    <button class="btn btn-primary" onclick="openModal()"><i class="bi bi-person-plus me-1"></i> Add User</button>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Username</th><th>Full Name</th><th>Role</th><th class="text-end">Actions</th></tr></thead>
            <tbody id="tbody"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add User</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Username</label><input id="m_user" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Full Name</label><input id="m_name" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Password</label><input id="m_pwd" type="password" class="form-control" placeholder="At least 6 characters" /></div>
                    <div class="col-md-6">
                        <label class="form-label">Role</label>
                        <select id="m_role" class="form-select"><option>Officer</option><option>Admin</option></select>
                    </div>
                </div>
                <div id="formErr" class="alert alert-danger mt-3 mb-0 py-2 d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button id="saveBtn" class="btn btn-primary" onclick="save()">Create User</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API = '/api/users';
        const modal = new bootstrap.Modal($('userModal'));
        let rows = [];

        async function load() {
            rows = await (await request(API)).json();
            $('tbody').innerHTML = rows.map(u => `
                <tr><td class="fw-semibold">${esc(u.username)}</td><td>${esc(u.fullName)}</td>
                <td><span class="risk ${u.role === 'Admin' ? 'risk-high' : 'risk-low'}">${u.role}</span></td>
                <td class="text-end"><button class="btn btn-icon btn-outline-danger" title="Delete" onclick="del(${u.id})"><i class="bi bi-trash3"></i></button></td></tr>`).join('');
        }
        function openModal() {
            ['m_user', 'm_name', 'm_pwd'].forEach(i => $(i).value = ''); $('m_role').value = 'Officer';
            $('formErr').classList.add('d-none'); modal.show();
        }
        function showErr(m) { $('formErr').textContent = m; $('formErr').classList.remove('d-none'); }

        async function save() {
            const body = { username: $('m_user').value.trim(), fullName: $('m_name').value.trim(), password: $('m_pwd').value, role: $('m_role').value };
            if (!body.username || !body.fullName) return showErr('Username and full name are required.');
            if (body.password.length < 6) return showErr('Password must be at least 6 characters.');
            const btn = $('saveBtn'); btn.disabled = true;
            try {
                const r = await request(API, jsonOpts('POST', body));
                if (!r.ok) return showErr(errText(await r.json().catch(() => ({}))));
                modal.hide(); toast('success', 'User created'); load();
            } finally { btn.disabled = false; }
        }
        async function del(id) {
            const u = rows.find(x => x.id === id);
            if (!await confirmDelete('Delete this user?', `"${u.username}" will not be able to sign in anymore.`)) return;
            const r = await request(`${API}/${id}`, { method: 'DELETE' });
            if (!r.ok) return toast('error', errText(await r.json().catch(() => ({}))));
            toast('success', 'User deleted'); load();
        }
        load();
    </script>
}