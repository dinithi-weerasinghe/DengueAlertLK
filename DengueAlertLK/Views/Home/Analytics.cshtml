@{
    ViewData["Title"] = "Analytics";
}

<div class="page-head">
    <div><h1>Analytics</h1><p>Dengue cases and recoveries over the last 12 months.</p></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="stat"><div class="icon bg-purple"><i class="bi bi-people-fill"></i></div><div><div class="label">Total Cases (12 mo)</div><div class="value" id="aTotal">0</div></div></div></div>
    <div class="col-md-3"><div class="stat"><div class="icon bg-green"><i class="bi bi-shield-check"></i></div><div><div class="label">Recovered</div><div class="value" id="aRec">0</div></div></div></div>
    <div class="col-md-3"><div class="stat"><div class="icon bg-orange"><i class="bi bi-percent"></i></div><div><div class="label">Recovery Rate</div><div class="value" id="aRate">0%</div></div></div></div>
    <div class="col-md-3"><div class="stat"><div class="icon bg-red"><i class="bi bi-graph-up-arrow"></i></div><div><div class="label">Peak Month</div><div class="value" id="aPeak" style="font-size:1.3rem">-</div></div></div></div>
</div>

<div class="panel">
    <div class="panel-head"><b>Monthly Cases</b></div>
    <div class="panel-body"><div style="height:380px"><canvas id="monthChart"></canvas></div></div>
</div>

@section Scripts {
    <script>
        async function load() {
            const d = await (await request('/api/dashboard/analytics')).json();
            const total = d.cases.reduce((a, b) => a + b, 0), rec = d.recovered.reduce((a, b) => a + b, 0);
            const peak = Math.max(...d.cases);

            $('aTotal').textContent = num(total);
            $('aRec').textContent = num(rec);
            $('aRate').textContent = total ? Math.round(rec * 100 / total) + '%' : '0%';
            $('aPeak').textContent = peak > 0 ? d.labels[d.cases.indexOf(peak)] : '-';

            new Chart($('monthChart'), {
                data: { labels: d.labels, datasets: [
                    { type: 'bar', label: 'Cases', data: d.cases, backgroundColor: '#f97316', borderRadius: 4 },
                    { type: 'line', label: 'Recovered', data: d.recovered, borderColor: '#0b8a72', backgroundColor: '#0b8a72', tension: .3 }] },
                options: { maintainAspectRatio: false, scales: { y: { beginAtZero: true, title: { display: true, text: 'Number of Cases' } } } }
            });
        }
        load();
    </script>
}