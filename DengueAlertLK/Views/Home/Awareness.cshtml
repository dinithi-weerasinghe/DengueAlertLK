@{
    ViewData["Title"] = "Awareness";
}

<div class="page-head">
    <div><h1>Dengue Awareness</h1><p>Know the facts. Prevention is better than cure.</p></div>
</div>

<div class="alert-banner mb-3">
    <i class="bi bi-megaphone"></i>
    <div>
        <div class="fw-bold">Stay Alert, Stay Safe!</div>
        <div class="small">Dengue is spread by Aedes mosquitoes, which breed in clean, stagnant water and bite mostly during the day.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-body">
                <h5 class="fw-bold"><i class="bi bi-droplet text-primary me-2"></i>Prevent mosquito breeding</h5>
                <ul class="mb-0">
                    <li>Remove stagnant water from flower pots, tyres, buckets, tins and coconut shells.</li>
                    <li>Clean roof gutters and water tanks regularly, and keep water containers covered.</li>
                    <li>Change the water in vases and pet bowls at least once a week.</li>
                    <li>Keep your home and surroundings clean and dry.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-body">
                <h5 class="fw-bold"><i class="bi bi-shield-check text-success me-2"></i>Protect yourself</h5>
                <ul class="mb-0">
                    <li>Use mosquito repellent, especially in the morning and late afternoon.</li>
                    <li>Wear full sleeve clothes and long trousers.</li>
                    <li>Use mosquito nets and window screens where possible.</li>
                    <li>Take part in community clean-up programmes.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-body">
                <h5 class="fw-bold"><i class="bi bi-thermometer-half text-warning me-2"></i>Common symptoms</h5>
                <ul class="mb-0">
                    <li>Sudden high fever</li>
                    <li>Severe headache and pain behind the eyes</li>
                    <li>Muscle and joint pain</li>
                    <li>Skin rash, nausea and vomiting</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-body">
                <h5 class="fw-bold"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Get medical help immediately if</h5>
                <ul class="mb-2">
                    <li>There is severe stomach pain or repeated vomiting.</li>
                    <li>There is bleeding from the gums or nose, or blood in vomit or stools.</li>
                    <li>The person is very tired, restless or unusually drowsy.</li>
                    <li>The fever drops but the person becomes worse.</li>
                </ul>
                <div class="text-muted small">This is general information and not medical advice. Please consult a doctor if you suspect dengue.</div>
            </div>
        </div>
    </div>
</div>